{
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@aikit/admin-core": ["./packages/admin-core/src/index.ts"],
      "@aikit/admin-rbac": ["./packages/admin-rbac/src/index.ts"],
      "@aikit/admin-rbac/admin": ["./packages/admin-rbac/src/admin.ts"],
      "@aikit/admin-audit": ["./packages/admin-audit/src/index.ts"],
      "@aikit/admin-audit/client": ["./packages/admin-audit/src/client.ts"],
      "@aikit/admin-rls": ["./packages/admin-rls/src/index.ts"],
      "@aikit/admin-params": ["./packages/admin-params/src/index.ts"],
      "@aikit/admin-jobs": ["./packages/admin-jobs/src/index.ts"],
      "@aikit/admin-jobs/admin": ["./packages/admin-jobs/src/admin.ts"],
      "@aikit/admin-jobs/worker": ["./packages/admin-jobs/src/worker.ts"],
      "@/audit/*": ["./packages/admin-audit/src/*"],
      "@/access/*": ["./packages/admin-rbac/src/access/*"],
      "@/rbac/*": ["./packages/admin-rbac/src/rbac/*"],
      "@/scope/*": ["./packages/admin-rls/src/*"],
      "@/system-parameters/*": ["./packages/admin-params/src/*"],
      "@/jobs/*": ["./packages/admin-jobs/src/*"],
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"]
    },
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".open-next"
  ]
}
