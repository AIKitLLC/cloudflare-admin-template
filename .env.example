# A generated secret for Payload. Store this as a Worker secret, not a var.
PAYLOAD_SECRET=

# Public origin of this app. Required in production (startup throws if it is missing).
# Local dev, tests, and `next build` fall back to http://localhost:3000 when it is unset.
# Example: https://admin.example.com
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Optional comma-separated extra origins for CORS and CSRF.
# Example: https://admin.example.com,https://preview.example.com
PAYLOAD_ALLOWED_ORIGINS=

# Optional. Production uses Cloudflare Queues only when the JOB_QUEUE binding exists.
# That binding is commented out in wrangler.jsonc until the queues exist.
# Without it, the cron in wrangler.jsonc runs due jobs. `inline` forces the Node runner.
# JOBS_DELIVERY=
# JOBS_AUTORUN=0
# Required in production. The deploy button discovers this active entry.
# For CLI deployments, use `wrangler secret put JOBS_INTERNAL_SECRET`.
# Do not put this name in wrangler.jsonc vars. The production Worker refuses a
# missing value, this placeholder, or anything shorter than 32 characters.
JOBS_INTERNAL_SECRET=

