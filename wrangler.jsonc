{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "my-app",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  // Production requires PAYLOAD_PUBLIC_SERVER_URL. Admin sessions, CSRF, and media
  // URLs use it. PAYLOAD_ALLOWED_ORIGINS is an optional comma-separated extra list.
  // Keep PAYLOAD_SECRET as a secret, not a var.
  // "vars": {
  //   "PAYLOAD_PUBLIC_SERVER_URL": "https://admin.example.com",
  //   "PAYLOAD_ALLOWED_ORIGINS": "https://admin.example.com"
  // },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "DATABASE_ID",
      "database_name": "my-app",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "my-app",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // PLACEHOLDER background jobs. These queue names are not Cloudflare resources.
  // Do not deploy, and do not create the queues, until the names below are replaced.
  // The producer binding JOB_QUEUE and the consumer must use the same queue name.
  // placeholder-jobs-dlq is the queue-level dead letter (delivery failures).
  // A job that exhausts application attempts is marked FAILED on the jobs row.
  // The cron runs the lease reaper and wakes due PENDING jobs.
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "placeholder-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "placeholder-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "placeholder-jobs-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
